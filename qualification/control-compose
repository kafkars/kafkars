#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 2 || -z "${KAFKARS_COMPOSE_PROJECT:-}" || -z "${KAFKARS_COMPOSE_FILES:-}" ]]; then
  echo "qualification control requires ACTION TARGET and runner Compose context" >&2
  exit 2
fi

action=$1
target=$2
IFS=: read -r -a files <<<"$KAFKARS_COMPOSE_FILES"
compose=(docker compose --project-name "$KAFKARS_COMPOSE_PROJECT")
for file in "${files[@]}"; do
  compose+=(-f "$file")
done

service_for() {
  if [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo "broker ID must be a positive integer" >&2
    exit 2
  fi
  printf 'kafka-%s\n' "$1"
}

wait_for_broker() {
  local service=$1
  for _ in $(seq 1 60); do
    if "${compose[@]}" exec -T "$service" \
      /opt/kafka/bin/kafka-broker-api-versions.sh \
      --bootstrap-server "$service:19092" >/dev/null 2>&1; then
      return
    fi
    sleep 2
  done
  echo "$service did not become ready within 120 seconds" >&2
  exit 1
}

coordinator_id_from_state() {
  local group=$1
  LC_ALL=C awk -v group="$group" '
    $1 == group {
      for (field = 2; field <= 3 && field <= NF; field++) {
        candidate = $field
        if (candidate ~ /^[1-9][0-9]*$/) {
          print candidate
          found = 1
          exit
        }
        if (candidate ~ /^\([1-9][0-9]*\)$/) {
          sub(/^\(/, "", candidate)
          sub(/\)$/, "", candidate)
          print candidate
          found = 1
          exit
        }
      }
    }
    END {
      if (!found) {
        exit 1
      }
    }
  '
}

find_coordinator() {
  local group=$1
  local output
  local coordinator
  for _ in $(seq 1 60); do
    if output=$("${compose[@]}" exec -T kafka-1 \
      /opt/kafka/bin/kafka-consumer-groups.sh \
      --bootstrap-server kafka-1:19092 --describe --group "$group" --state 2>&1) &&
      coordinator=$(coordinator_id_from_state "$group" <<<"$output"); then
      printf '%s\n' "$coordinator"
      return
    fi
    sleep 2
  done
  echo "coordinator for group $group did not become queryable within 120 seconds" >&2
  return 1
}

case "$action" in
  stop)
    service=$(service_for "$target")
    "${compose[@]}" stop "$service" >&2
    ;;
  start)
    service=$(service_for "$target")
    "${compose[@]}" start "$service" >&2
    wait_for_broker "$service"
    ;;
  pause | unpause)
    service=$(service_for "$target")
    "${compose[@]}" "$action" "$service" >&2
    ;;
  restart)
    service=$(service_for "$target")
    "${compose[@]}" stop "$service" >&2
    sleep 5
    "${compose[@]}" start "$service" >&2
    wait_for_broker "$service"
    ;;
  restart-coordinator)
    coordinator=$(find_coordinator "$target")
    service=$(service_for "$coordinator")
    "${compose[@]}" stop "$service" >&2
    sleep 8
    "${compose[@]}" start "$service" >&2
    wait_for_broker "$service"
    printf '%s\n' "$coordinator"
    ;;
  *)
    echo "unsupported qualification control action: $action" >&2
    exit 2
    ;;
esac

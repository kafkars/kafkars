#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
parent_root=$(cd "$repo_root/.." && pwd)
revision_file="$repo_root/dependencies/sibling-revisions.env"
attestation_file="$repo_root/dependencies/public-sibling-pair.tsv"
driver_root="$parent_root/kafka-driver"
protocol_root="$parent_root/kafka-protocol"
driver_repository=${KAFKA_CLIENT_DRIVER_REPOSITORY:-https://github.com/kafkars/kafka-driver.git}
protocol_repository=${KAFKA_CLIENT_PROTOCOL_REPOSITORY:-https://github.com/kafkars/kafka-wire.git}

if [[ ! -f "$revision_file" || -L "$revision_file" ]]; then
  echo "revision file must be a regular, non-symlink file" >&2
  exit 1
fi
revision_lines=()
while IFS= read -r revision_line || [[ -n "$revision_line" ]]; do
  revision_lines+=("$revision_line")
done < "$revision_file"
if [[ "${#revision_lines[@]}" -ne 2 ]]; then
  echo "revision file must contain exactly two assignments" >&2
  exit 1
fi
if [[ ! "${revision_lines[0]}" =~ ^KAFKA_DRIVER_REVISION=([0-9a-f]{40})$ ]]; then
  echo "invalid kafka-driver revision assignment" >&2
  exit 1
fi
driver_revision="${BASH_REMATCH[1]}"
if [[ ! "${revision_lines[1]}" =~ ^KAFKA_PROTOCOL_REVISION=([0-9a-f]{40})$ ]]; then
  echo "invalid kafka-protocol revision assignment" >&2
  exit 1
fi
protocol_revision="${BASH_REMATCH[1]}"

if [[ ! -f "$attestation_file" || -L "$attestation_file" ]]; then
  echo "public sibling-pair attestation must be a regular, non-symlink file" >&2
  exit 1
fi
attestation_lines=()
while IFS= read -r attestation_line || [[ -n "$attestation_line" ]]; do
  attestation_lines+=("$attestation_line")
done < "$attestation_file"
if [[ "${#attestation_lines[@]}" -ne 2 ]]; then
  echo "public sibling-pair attestation must contain exactly one header and one row" >&2
  exit 1
fi
attestation_header=$'driver_revision\twire_revision\tdriver_runtime_fingerprint\twire_runtime_fingerprint\tdriver_declared_wire_revision'
if [[ "${attestation_lines[0]}" != "$attestation_header" ]]; then
  echo "public sibling-pair attestation has a noncanonical header" >&2
  exit 1
fi
tab=$'\t'
attestation_pattern="^([0-9a-f]{40})${tab}([0-9a-f]{40})${tab}([0-9a-f]{40})${tab}([0-9a-f]{40})${tab}([0-9a-f]{40})$"
if [[ ! "${attestation_lines[1]}" =~ $attestation_pattern ]]; then
  echo "public sibling-pair attestation has a noncanonical row" >&2
  exit 1
fi
if [[ "${BASH_REMATCH[1]}" != "$driver_revision" ]]; then
  echo "public sibling-pair driver revision does not match sibling-revisions.env" >&2
  exit 1
fi
if [[ "${BASH_REMATCH[2]}" != "$protocol_revision" ]]; then
  echo "public sibling-pair wire revision does not match sibling-revisions.env" >&2
  exit 1
fi

command -v git >/dev/null 2>&1 || {
  echo "git is required to bootstrap sibling dependencies" >&2
  exit 1
}

if [[ -e "$driver_root" || -L "$driver_root" || -e "$protocol_root" || -L "$protocol_root" ]]; then
  if [[ ! -d "$driver_root" || -L "$driver_root" || ! -d "$protocol_root" || -L "$protocol_root" ]]; then
    echo "existing sibling state is incomplete or noncanonical; refusing to modify it" >&2
    exit 1
  fi
  "$repo_root/scripts/check-dependency-provenance"
  echo "sibling checkouts already match the reviewed public pair"
  exit 0
fi

stage_root=$(mktemp -d "$parent_root/.kafka-client-bootstrap.XXXXXX")
cleanup() {
  rm -rf -- "$stage_root"
}
trap cleanup EXIT

materialize_staged() {
  local name=$1
  local repository=$2
  local revision=$3
  local staged="$stage_root/$name"
  local actual

  git init -q "$staged"
  git -C "$staged" remote add origin "$repository"
  git -C "$staged" fetch --quiet --depth=1 origin "$revision"
  actual=$(git -C "$staged" rev-parse --verify 'FETCH_HEAD^{commit}' 2>/dev/null) || {
    echo "$name fetch did not resolve one commit" >&2
    return 1
  }
  if [[ "$actual" != "$revision" ]]; then
    echo "$name fetch resolved $actual instead of reviewed revision $revision" >&2
    return 1
  fi
  git -C "$staged" checkout --quiet --detach "$revision"
  if [[ "$(git -C "$staged" rev-parse --verify 'HEAD^{commit}')" != "$revision" ]]; then
    echo "$name checkout did not retain reviewed revision $revision" >&2
    return 1
  fi
}

materialize_staged kafka-driver "$driver_repository" "$driver_revision"
materialize_staged kafka-protocol "$protocol_repository" "$protocol_revision"

KAFKA_CLIENT_DRIVER_ROOT="$stage_root/kafka-driver" \
  KAFKA_CLIENT_PROTOCOL_ROOT="$stage_root/kafka-protocol" \
  "$repo_root/scripts/check-dependency-provenance"

if [[ -e "$driver_root" || -L "$driver_root" || -e "$protocol_root" || -L "$protocol_root" ]]; then
  echo "a sibling checkout appeared while the reviewed pair was fetched; refusing to replace it" >&2
  exit 1
fi
mv "$stage_root/kafka-driver" "$driver_root"
mv "$stage_root/kafka-protocol" "$protocol_root"

"$repo_root/scripts/check-dependency-provenance"
echo "installed reviewed public sibling pair driver=$driver_revision wire=$protocol_revision"

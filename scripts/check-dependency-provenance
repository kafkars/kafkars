#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
driver_root="${KAFKA_CLIENT_DRIVER_ROOT:-$repo_root/../kafka-driver}"
protocol_root="${KAFKA_CLIENT_PROTOCOL_ROOT:-$repo_root/../kafka-protocol}"
revision_file="$repo_root/dependencies/sibling-revisions.env"
attestation_file="$repo_root/dependencies/public-sibling-pair.tsv"

if [[ ! -f "$revision_file" || -L "$revision_file" ]]; then
  echo "revision file must be a regular, non-symlink file" >&2
  exit 1
fi
revision_lines=()
while IFS= read -r revision_line || [[ -n "$revision_line" ]]; do
  revision_lines+=("$revision_line")
done < "$revision_file"
if [[ "${#revision_lines[@]}" -ne 2 ]]; then
  echo "revision file must contain exactly two assignments" >&2
  exit 1
fi
if [[ ! "${revision_lines[0]}" =~ ^KAFKA_DRIVER_REVISION=([0-9a-f]{40})$ ]]; then
  echo "invalid kafka-driver revision assignment" >&2
  exit 1
fi
KAFKA_DRIVER_REVISION="${BASH_REMATCH[1]}"
if [[ ! "${revision_lines[1]}" =~ ^KAFKA_PROTOCOL_REVISION=([0-9a-f]{40})$ ]]; then
  echo "invalid kafka-protocol revision assignment" >&2
  exit 1
fi
KAFKA_PROTOCOL_REVISION="${BASH_REMATCH[1]}"

if [[ ! -f "$attestation_file" || -L "$attestation_file" ]]; then
  echo "public sibling-pair attestation must be a regular, non-symlink file" >&2
  exit 1
fi
attestation_lines=()
while IFS= read -r attestation_line || [[ -n "$attestation_line" ]]; do
  attestation_lines+=("$attestation_line")
done < "$attestation_file"
if [[ "${#attestation_lines[@]}" -ne 2 ]]; then
  echo "public sibling-pair attestation must contain exactly one header and one row" >&2
  exit 1
fi
attestation_header=$'driver_revision\twire_revision\tdriver_runtime_fingerprint\twire_runtime_fingerprint\tdriver_declared_wire_revision'
if [[ "${attestation_lines[0]}" != "$attestation_header" ]]; then
  echo "public sibling-pair attestation has a noncanonical header" >&2
  exit 1
fi
tab=$'\t'
attestation_pattern="^([0-9a-f]{40})${tab}([0-9a-f]{40})${tab}([0-9a-f]{40})${tab}([0-9a-f]{40})${tab}([0-9a-f]{40})$"
if [[ ! "${attestation_lines[1]}" =~ $attestation_pattern ]]; then
  echo "public sibling-pair attestation has a noncanonical row" >&2
  exit 1
fi
attested_driver_revision="${BASH_REMATCH[1]}"
attested_wire_revision="${BASH_REMATCH[2]}"
attested_driver_runtime="${BASH_REMATCH[3]}"
attested_wire_runtime="${BASH_REMATCH[4]}"
attested_driver_wire_revision="${BASH_REMATCH[5]}"
if [[ "$attested_driver_revision" != "$KAFKA_DRIVER_REVISION" ]]; then
  echo "public sibling-pair driver revision does not match sibling-revisions.env" >&2
  exit 1
fi
if [[ "$attested_wire_revision" != "$KAFKA_PROTOCOL_REVISION" ]]; then
  echo "public sibling-pair wire revision does not match sibling-revisions.env" >&2
  exit 1
fi

check_revision() {
  local name=$1
  local checkout=$2
  local expected=$3
  local actual
  local index_state
  local unexpected
  local status
  local tree

  actual=$(git -C "$checkout" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) || {
    echo "$name is not checked out at $checkout" >&2
    return 1
  }
  if [[ "$actual" != "$expected" ]]; then
    echo "$name revision $actual does not match reviewed revision $expected" >&2
    return 1
  fi
  index_state=$(LC_ALL=C git -C "$checkout" ls-files -v -f) || {
    echo "could not inspect $name index flags at $checkout" >&2
    return 1
  }
  while IFS= read -r entry; do
    if [[ -n "$entry" && "$entry" != "H "* ]]; then
      echo "$name index contains a noncanonical tracked-path flag: $entry" >&2
      return 1
    fi
  done <<< "$index_state"
  status=$(
    LC_ALL=C git -C "$checkout" status \
      --porcelain=v1 \
      --untracked-files=all \
      --ignored=matching
  ) || {
    echo "could not inspect $name worktree at $checkout" >&2
    return 1
  }
  unexpected=
  while IFS= read -r entry; do
    if [[ -n "$entry" && "$entry" != "!! target/"* ]]; then
      unexpected+="${unexpected:+$'\n'}$entry"
    fi
  done <<< "$status"
  if [[ -n "$unexpected" ]]; then
    echo "$name worktree at $checkout differs from reviewed commit $expected:" >&2
    echo "$unexpected" >&2
    return 1
  fi
  tree=$(git -C "$checkout" rev-parse --verify 'HEAD^{tree}' 2>/dev/null) || {
    echo "could not resolve $name tree at $checkout" >&2
    return 1
  }
  echo "$name commit=$actual tree=$tree"
}

driver_protocol_revision_at() {
  local revision=$1
  local declaration
  local declarations=()
  local declared
  local driver_policy

  driver_policy=$(git -C "$driver_root" show "$revision:guardrails.toml" 2>/dev/null) || {
    echo "kafka-driver protocol revision policy is missing at $revision" >&2
    return 1
  }
  while IFS= read -r declaration; do
    declarations+=("$declaration")
  done < <(printf '%s\n' "$driver_policy" | LC_ALL=C grep -E '^kafka_wire_revision[[:space:]]*=' || true)
  if [[ "${#declarations[@]}" -ne 1 ]]; then
    echo "kafka-driver must declare exactly one kafka_wire_revision" >&2
    return 1
  fi
  declaration="${declarations[0]}"
  if [[ ! "$declaration" =~ ^kafka_wire_revision[[:space:]]*=[[:space:]]*\"([0-9a-f]{40})\"$ ]]; then
    echo "kafka-driver kafka_wire_revision must be one canonical 40-hex TOML string" >&2
    return 1
  fi
  declared="${BASH_REMATCH[1]}"
  printf '%s\n' "$declared"
}

driver_runtime_fingerprint() {
  git -C "$driver_root" ls-tree -r "$1" -- src crates |
    git hash-object --stdin
}

wire_runtime_fingerprint() {
  local entry
  git -C "$protocol_root" ls-tree -r "$1" -- \
    crates/kafka-wire-core crates/kafka-wire-records crates/kafka-wire |
    while IFS= read -r entry; do
      case "$entry" in
        *$'\tcrates/kafka-wire-core/src/lib.rs' | \
        *$'\tcrates/kafka-wire/Cargo.toml' | \
        *$'\tcrates/kafka-wire/src/generated/MANIFEST.json' | \
        *$'\tcrates/kafka-wire/src/lib.rs') ;;
        *) printf '%s\n' "$entry" ;;
      esac
    done |
    git hash-object --stdin
}

check_revision kafka-driver "$driver_root" "$KAFKA_DRIVER_REVISION"
actual_driver_runtime=$(driver_runtime_fingerprint "$KAFKA_DRIVER_REVISION") || {
  echo "could not fingerprint reviewed kafka-driver runtime $KAFKA_DRIVER_REVISION" >&2
  exit 1
}
if [[ "$actual_driver_runtime" != "$attested_driver_runtime" ]]; then
  echo "reviewed kafka-driver runtime fingerprint $actual_driver_runtime does not match public sibling-pair attestation $attested_driver_runtime" >&2
  exit 1
fi
actual_driver_wire_revision=$(driver_protocol_revision_at "$KAFKA_DRIVER_REVISION") || exit 1
if [[ "$actual_driver_wire_revision" != "$attested_driver_wire_revision" ]]; then
  echo "kafka-driver declared wire revision $actual_driver_wire_revision does not match public sibling-pair attestation $attested_driver_wire_revision" >&2
  exit 1
fi

check_revision kafka-protocol "$protocol_root" "$KAFKA_PROTOCOL_REVISION"
actual_wire_runtime=$(wire_runtime_fingerprint "$KAFKA_PROTOCOL_REVISION") || {
  echo "could not fingerprint reviewed kafka-wire runtime $KAFKA_PROTOCOL_REVISION" >&2
  exit 1
}
if [[ "$actual_wire_runtime" != "$attested_wire_runtime" ]]; then
  echo "reviewed kafka-wire runtime fingerprint $actual_wire_runtime does not match public sibling-pair attestation $attested_wire_runtime" >&2
  exit 1
fi

echo \
  "public-sibling-pair driver=$KAFKA_DRIVER_REVISION wire=$KAFKA_PROTOCOL_REVISION driver-runtime=$actual_driver_runtime wire-runtime=$actual_wire_runtime driver-declared-wire=$actual_driver_wire_revision"

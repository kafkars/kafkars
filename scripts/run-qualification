#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
matrix="$repo_root/qualification/matrix.json"

usage() {
  echo "usage: scripts/run-qualification EVIDENCE_SET PROFILE KAFKA_VERSION SECURITY OUTPUT" >&2
}

if [[ "$#" -ne 5 ]]; then
  usage
  exit 2
fi

evidence_set=$1
profile=$2
kafka_version=$3
security=$4
output_argument=$5

case "$kafka_version" in
  4.3.1 | 4.2.1 | 4.1.2 | 4.0.2 | 3.9.2 | 3.8.1 | 3.7.2) ;;
  *)
    echo "Kafka $kafka_version is outside qualification/matrix.json" >&2
    exit 2
    ;;
esac

"$repo_root/scripts/render-qualification" policy \
  --matrix "$matrix" \
  --evidence-set "$evidence_set" \
  --profile "$profile" \
  --kafka-version "$kafka_version" \
  --security "$security"

compose_files=()
case "$profile" in
  compatibility-smoke)
    test_name=pull_request_smoke
    readiness_service=broker
    readiness_bootstrap=broker:19092
    expected_broker_ids=1
    compose_files+=("$repo_root/qualification/compose/pr-smoke.yml")
    bootstrap="localhost:${KAFKA_HOST_PORT:-9092}"
    ;;
  security-smoke | full | classic)
    readiness_service=kafka-1
    readiness_bootstrap=kafka-1:19092
    expected_broker_ids=1,2,3
    compose_files+=("$repo_root/qualification/compose/cluster.yml")
    bootstrap="localhost:${KAFKA_BROKER_1_PORT:-29092},localhost:${KAFKA_BROKER_2_PORT:-39092},localhost:${KAFKA_BROKER_3_PORT:-49092}"
    case "$profile" in
      security-smoke) test_name=pull_request_smoke ;;
      full) test_name=nightly_matrix ;;
      classic) test_name=classic_matrix ;;
    esac
    ;;
  *)
    echo "unknown qualification profile: $profile" >&2
    exit 2
    ;;
esac

check_client_worktree() {
  local entry
  local index_state
  local status
  local unexpected=

  index_state=$(LC_ALL=C git -C "$repo_root" ls-files -v -f) || {
    echo "could not inspect client index flags" >&2
    return 1
  }
  while IFS= read -r entry; do
    if [[ -n "$entry" && "$entry" != "H "* ]]; then
      echo "client index contains a noncanonical tracked-path flag: $entry" >&2
      return 1
    fi
  done <<<"$index_state"

  status=$(
    LC_ALL=C git -C "$repo_root" status \
      --porcelain=v1 \
      --untracked-files=all \
      --ignored=matching
  ) || {
    echo "could not inspect client worktree" >&2
    return 1
  }
  while IFS= read -r entry; do
    if [[ -n "$entry" && "$entry" != "!! target/"* ]]; then
      unexpected+="${unexpected:+$'\n'}$entry"
    fi
  done <<<"$status"
  if [[ -n "$unexpected" ]]; then
    echo "client worktree differs from its recorded commit:" >&2
    echo "$unexpected" >&2
    return 1
  fi
}

check_client_worktree
"$repo_root/scripts/check-dependency-provenance"

mkdir -p "$output_argument"
output=$(cd "$output_argument" && pwd -P)
if [[ "$output/" == "$repo_root/"* ]]; then
  echo "qualification output must be outside the client worktree: $output" >&2
  exit 1
fi
if find "$output" -mindepth 1 -print -quit | grep -q .; then
  echo "qualification output directory must be empty: $output" >&2
  exit 1
fi

image="apache/kafka:$kafka_version"
docker pull "$image"
docker image inspect "$image" >"$output/image-inspect.json"
digest_reference=$(docker image inspect \
  --format '{{range .RepoDigests}}{{println .}}{{end}}' "$image" |
  awk '$0 ~ /^apache\/kafka@sha256:/ { print; exit }')
if [[ ! "$digest_reference" =~ ^apache/kafka@(sha256:[0-9a-f]{64})$ ]]; then
  echo "the pulled Kafka image did not expose one exact repository digest" >&2
  exit 1
fi
image_digest=${BASH_REMATCH[1]}
export IMAGE="apache/kafka@$image_digest"
export KAFKA_HOST_PORT=${KAFKA_HOST_PORT:-9092}
export KAFKA_BROKER_1_PORT=${KAFKA_BROKER_1_PORT:-29092}
export KAFKA_BROKER_2_PORT=${KAFKA_BROKER_2_PORT:-39092}
export KAFKA_BROKER_3_PORT=${KAFKA_BROKER_3_PORT:-49092}

unset KAFKA_CLIENT_TEST_TLS_CA_PEM
unset KAFKA_CLIENT_TEST_SASL_USERNAME
unset KAFKA_CLIENT_TEST_SASL_PASSWORD
unset KAFKA_CLIENT_TEST_SASL_MECHANISM
unset KAFKA_CLIENT_TEST_TLS_MISMATCH_BOOTSTRAP
unset KAFKA_TLS_PASSWORD
unset SSL_CERT_FILE

uses_tls=0
uses_sasl=0
sasl_mechanism=
case "$security" in
  plaintext)
    export KAFKA_EXTERNAL_PROTOCOL=PLAINTEXT
    export KAFKA_CLIENT_TEST_SECURITY=plaintext
    ;;
  tls_custom)
    uses_tls=1
    export KAFKA_EXTERNAL_PROTOCOL=SSL
    export KAFKA_CLIENT_TEST_SECURITY=tls
    ;;
  sasl_plaintext_plain)
    uses_sasl=1
    sasl_mechanism=plain
    export KAFKA_EXTERNAL_PROTOCOL=SASL_PLAINTEXT
    export KAFKA_CLIENT_TEST_SECURITY=sasl_plaintext
    ;;
  sasl_plaintext_scram_sha_256)
    uses_sasl=1
    sasl_mechanism=scram_sha_256
    export KAFKA_EXTERNAL_PROTOCOL=SASL_PLAINTEXT
    export KAFKA_CLIENT_TEST_SECURITY=sasl_plaintext
    ;;
  sasl_plaintext_scram_sha_512)
    uses_sasl=1
    sasl_mechanism=scram_sha_512
    export KAFKA_EXTERNAL_PROTOCOL=SASL_PLAINTEXT
    export KAFKA_CLIENT_TEST_SECURITY=sasl_plaintext
    ;;
  sasl_tls_custom_plain)
    uses_tls=1
    uses_sasl=1
    sasl_mechanism=plain
    export KAFKA_EXTERNAL_PROTOCOL=SASL_SSL
    export KAFKA_CLIENT_TEST_SECURITY=sasl_tls
    ;;
  sasl_tls_custom_scram_sha_256)
    uses_tls=1
    uses_sasl=1
    sasl_mechanism=scram_sha_256
    export KAFKA_EXTERNAL_PROTOCOL=SASL_SSL
    export KAFKA_CLIENT_TEST_SECURITY=sasl_tls
    ;;
  sasl_tls_custom_scram_sha_512)
    uses_tls=1
    uses_sasl=1
    sasl_mechanism=scram_sha_512
    export KAFKA_EXTERNAL_PROTOCOL=SASL_SSL
    export KAFKA_CLIENT_TEST_SECURITY=sasl_tls
    ;;
  *)
    echo "unsupported qualification security implementation: $security" >&2
    exit 2
    ;;
esac

secret_root=
started=0
compose=()

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [[ "$started" -eq 1 ]]; then
    "${compose[@]}" ps --all >>"$output/compose-ps.txt" 2>&1 || true
    "${compose[@]}" logs --no-color >>"$output/broker.log" 2>&1 || true
    "${compose[@]}" down --volumes --remove-orphans \
      >>"$output/compose-down.log" 2>&1 || true
  fi
  if [[ -n "$secret_root" && -d "$secret_root" ]]; then
    rm -rf -- "$secret_root"
  fi
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

qualification_username=kafkars
qualification_password=kafkars-qualification-password
secret_dir=
if [[ "$uses_tls" -eq 1 || "$uses_sasl" -eq 1 ]]; then
  secret_root=$(mktemp -d "${TMPDIR:-/tmp}/kafkars-qualification.XXXXXX")
  secret_dir="$secret_root/secrets"
  mkdir -m 0755 "$secret_dir"
fi
if [[ "$uses_tls" -eq 1 ]]; then
  export KAFKA_TLS_DIR="$secret_dir"
  export KAFKA_TLS_PASSWORD="$qualification_password"
  "$repo_root/qualification/generate-tls" "$KAFKA_TLS_DIR" "$qualification_password"
  compose_files+=("$repo_root/qualification/compose/cluster-tls.yml")
  export KAFKA_CLIENT_TEST_TLS_CA_PEM="$KAFKA_TLS_DIR/ca.pem"
  export KAFKA_CLIENT_TEST_TLS_MISMATCH_BOOTSTRAP="127.0.0.1:$KAFKA_BROKER_1_PORT"
fi
if [[ "$uses_sasl" -eq 1 ]]; then
  cp "$repo_root/qualification/sasl/broker_jaas.conf" "$secret_dir/broker_jaas.conf"
  chmod 0444 "$secret_dir/broker_jaas.conf"
  export KAFKA_SASL_DIR="$secret_dir"
  compose_files+=("$repo_root/qualification/compose/cluster-sasl.yml")
  export KAFKA_CLIENT_TEST_SASL_USERNAME="$qualification_username"
  export KAFKA_CLIENT_TEST_SASL_PASSWORD="$qualification_password"
  export KAFKA_CLIENT_TEST_SASL_MECHANISM="$sasl_mechanism"
fi

project="kafkars-${evidence_set//[^a-zA-Z0-9]/-}-${profile//[^a-zA-Z0-9]/-}-${security//_/-}-$$"
compose=(docker compose --project-name "$project")
for file in "${compose_files[@]}"; do
  compose+=(-f "$file")
done

"${compose[@]}" config >"$output/compose-config.yml"
started=1
"${compose[@]}" up --detach --no-build

metadata_has_exact_broker_ids() {
  local metadata=$1
  local expected=$2

  LC_ALL=C awk -v expected="$expected" '
    BEGIN {
      expected_count = split(expected, expected_ids, ",")
      for (position = 1; position <= expected_count; position++) {
        required[expected_ids[position]] = 1
      }
    }
    {
      for (field = 1; field + 2 <= NF; field++) {
        if (($field == "(id:" || $field == "id:") &&
            $(field + 1) ~ /^-?[0-9]+$/ && $(field + 2) == "rack:") {
          observed[$(field + 1)] = 1
        }
      }
    }
    END {
      observed_count = 0
      for (id in observed) {
        observed_count++
      }
      if (observed_count != expected_count) {
        exit 1
      }
      for (id in required) {
        if (!(id in observed)) {
          exit 1
        }
      }
    }
  ' "$metadata"
}

ready=0
readiness_attempt="$output/readiness-attempt.txt"
for _ in $(seq 1 60); do
  if "${compose[@]}" exec -T "$readiness_service" \
    /opt/kafka/bin/kafka-broker-api-versions.sh \
    --bootstrap-server "$readiness_bootstrap" >"$readiness_attempt" 2>&1; then
    if metadata_has_exact_broker_ids "$readiness_attempt" "$expected_broker_ids"; then
      mv "$readiness_attempt" "$output/readiness.txt"
      ready=1
      break
    fi
  fi
  mv "$readiness_attempt" "$output/readiness.txt"
  sleep 2
done
if [[ "$ready" -ne 1 ]]; then
  echo "Kafka did not expose exact broker IDs $expected_broker_ids within 120 seconds" >&2
  exit 1
fi

if [[ "$uses_sasl" -eq 1 && "$sasl_mechanism" != plain ]]; then
  case "$sasl_mechanism" in
    scram_sha_256) scram_mechanism=SCRAM-SHA-256 ;;
    scram_sha_512) scram_mechanism=SCRAM-SHA-512 ;;
  esac
  "${compose[@]}" exec -T kafka-1 /opt/kafka/bin/kafka-configs.sh \
    --bootstrap-server kafka-1:19092 --alter --entity-type users \
    --entity-name "$qualification_username" \
    --add-config "$scram_mechanism=[iterations=8192,password=$qualification_password]" \
    >"$output/scram-setup.txt" 2>&1
fi

parent_root=$(cd "$repo_root/.." && pwd)
client_sha=$(git -C "$repo_root" rev-parse --verify 'HEAD^{commit}')
driver_sha=$(git -C "$parent_root/kafka-driver" rev-parse --verify 'HEAD^{commit}')
wire_sha=$(git -C "$parent_root/kafka-protocol" rev-parse --verify 'HEAD^{commit}')
cargo metadata --manifest-path "$repo_root/Cargo.toml" --locked --format-version 1 \
  >"$output/crate-graph.json"

events="$output/events.tsv"
touch "$events"
export KAFKA_CLIENT_TEST_BOOTSTRAP="$bootstrap"
export KAFKARS_QUALIFICATION_EVENTS="$events"
export KAFKARS_QUALIFICATION_CONTROL="$repo_root/qualification/control-compose"
export KAFKARS_COMPOSE_PROJECT="$project"
export KAFKARS_COMPOSE_FILES
KAFKARS_COMPOSE_FILES=$(IFS=:; echo "${compose_files[*]}")

set +e
cargo test --manifest-path "$repo_root/Cargo.toml" --locked \
  -p kafkars --test real_broker_qualification \
  "$test_name" -- --ignored --exact --nocapture \
  >"$output/client.log" 2>&1
test_status=$?
set -e

run_recorded_test() {
  local scenario=$1
  local target=$2
  local test=$3
  local log=$4
  local listing="${log%.log}-list.txt"
  local before=$SECONDS
  local list_status
  local status
  local result=passed

  set +e
  CARGO_TERM_COLOR=never cargo test --manifest-path "$repo_root/Cargo.toml" --locked \
    -p kafkars --test "$target" \
    "$test" -- --ignored --exact --list \
    >"$output/$listing" 2>&1
  list_status=$?
  set -e
  status=$list_status
  if [[ "$list_status" -ne 0 ]]; then
    echo "failed to list exact libtest target $target::$test" >"$output/$log"
  elif ! "$repo_root/scripts/render-qualification" libtest \
    --listing "$output/$listing" \
    --test "$test" >"$output/$log" 2>&1; then
    status=1
  else
    set +e
    cargo test --manifest-path "$repo_root/Cargo.toml" --locked \
      -p kafkars --test "$target" \
      "$test" -- --ignored --exact --nocapture \
      >"$output/$log" 2>&1
    status=$?
    set -e
  fi
  if [[ "$status" -ne 0 ]]; then
    result=failed
  fi
  printf '%s\t%s\t%s\n' "$scenario" "$result" "$(((SECONDS - before) * 1000))" \
    >>"$events"
  return "$status"
}

if [[ "$uses_tls" -eq 1 ]]; then
  if ! run_recorded_test \
    tls_hostname_rejection \
    real_broker_tls_rejection_smoke \
    public_tls_rejects_mismatched_server_identity \
    tls-rejection.log; then
    test_status=1
  fi
fi
if [[ "$uses_sasl" -eq 1 ]]; then
  if ! run_recorded_test \
    sasl_wrong_secret_rejection \
    real_broker_sasl_rejection_smoke \
    configured_sasl_rejects_wrong_password_without_exposing_credentials \
    sasl-rejection.log; then
    test_status=1
  fi
fi

evidence_status=0
if ! "${compose[@]}" ps --all >"$output/compose-ps.txt" 2>&1; then
  echo "failed to capture Compose process state" >>"$output/evidence-errors.txt"
  evidence_status=1
fi
if ! "${compose[@]}" logs --no-color >"$output/broker.log" 2>&1; then
  echo "failed to capture broker logs" >>"$output/evidence-errors.txt"
  evidence_status=1
fi
if "${compose[@]}" down --volumes --remove-orphans \
  >"$output/compose-down.log" 2>&1; then
  started=0
else
  echo "failed to remove qualification cluster" >>"$output/evidence-errors.txt"
  evidence_status=1
fi

required_evidence=(
  image-inspect.json
  compose-config.yml
  readiness.txt
  crate-graph.json
  events.tsv
  client.log
  compose-ps.txt
  broker.log
)
if [[ "$uses_tls" -eq 1 ]]; then
  required_evidence+=(tls-rejection-list.txt tls-rejection.log)
fi
if [[ "$uses_sasl" -eq 1 ]]; then
  required_evidence+=(sasl-rejection-list.txt sasl-rejection.log)
fi
if [[ "$uses_sasl" -eq 1 && "$sasl_mechanism" != plain ]]; then
  required_evidence+=(scram-setup.txt)
fi
for evidence_file in "${required_evidence[@]}"; do
  if [[ ! -s "$output/$evidence_file" ]]; then
    echo "required evidence is missing or empty: $evidence_file" \
      >>"$output/evidence-errors.txt"
    evidence_status=1
  fi
done
if [[ ! -f "$output/compose-down.log" ]]; then
  echo "required evidence is missing: compose-down.log" >>"$output/evidence-errors.txt"
  evidence_status=1
fi

runner_status=passed
if [[ "$test_status" -ne 0 || "$evidence_status" -ne 0 ]]; then
  runner_status=failed
fi

set +e
"$repo_root/scripts/render-qualification" cell \
  --matrix "$matrix" \
  --evidence-set "$evidence_set" \
  --profile "$profile" \
  --kafka-version "$kafka_version" \
  --security "$security" \
  --runner-status "$runner_status" \
  --image "$image" \
  --image-digest "$image_digest" \
  --client-sha "$client_sha" \
  --driver-sha "$driver_sha" \
  --wire-sha "$wire_sha" \
  --events "$events" \
  --output "$output" \
  --support "$repo_root/SUPPORT.md" \
  --require-qualified
render_status=$?
set -e

if [[ "$test_status" -ne 0 || "$evidence_status" -ne 0 || "$render_status" -ne 0 ]]; then
  echo "qualification failed; inspect $output" >&2
  exit 1
fi
echo "qualification passed; evidence archived in $output"

#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
sandbox=$(mktemp -d)
trap 'rm -rf "$sandbox"' EXIT

driver_work="$sandbox/driver-work"
protocol_work="$sandbox/protocol-work"
driver_origin="$sandbox/kafka-driver-public.git"
protocol_origin="$sandbox/kafka-wire-public.git"
unreachable_declared_wire=1111111111111111111111111111111111111111

initialize_protocol() {
  mkdir -p \
    "$protocol_work/crates/kafka-wire-core/src" \
    "$protocol_work/crates/kafka-wire-records/src" \
    "$protocol_work/crates/kafka-wire/src/generated"
  git init -q "$protocol_work"
  git -C "$protocol_work" config user.name "bootstrap fixture"
  git -C "$protocol_work" config user.email "fixture@example.invalid"
  git -C "$protocol_work" config commit.gpgsign false
  printf 'target/\n' > "$protocol_work/.gitignore"
  printf '//! fixture wire facade\n' \
    > "$protocol_work/crates/kafka-wire-core/src/lib.rs"
  printf 'pub struct PreviousWireRuntime;\n' \
    > "$protocol_work/crates/kafka-wire-core/src/runtime.rs"
  git -C "$protocol_work" add .
  git -C "$protocol_work" commit -q -m "fixture: previous public wire"
  printf 'pub struct ReviewedWireRuntime;\n' \
    >> "$protocol_work/crates/kafka-wire-core/src/runtime.rs"
  git -C "$protocol_work" add .
  git -C "$protocol_work" commit -q -m "fixture: reviewed public wire"
}

initialize_driver() {
  mkdir -p "$driver_work/src"
  git init -q "$driver_work"
  git -C "$driver_work" config user.name "bootstrap fixture"
  git -C "$driver_work" config user.email "fixture@example.invalid"
  git -C "$driver_work" config commit.gpgsign false
  printf 'target/\n' > "$driver_work/.gitignore"
  printf 'kafka_wire_revision = "%s"\n' "$unreachable_declared_wire" \
    > "$driver_work/guardrails.toml"
  printf 'pub struct PreviousDriverRuntime;\n' > "$driver_work/src/lib.rs"
  git -C "$driver_work" add .
  git -C "$driver_work" commit -q -m "fixture: previous public driver"
  printf 'pub struct ReviewedDriverRuntime;\n' >> "$driver_work/src/lib.rs"
  git -C "$driver_work" add .
  git -C "$driver_work" commit -q -m "fixture: reviewed public driver"
}

driver_runtime_fingerprint() {
  local revision=$1
  git -C "$driver_work" ls-tree -r "$revision" -- src crates |
    git hash-object --stdin
}

wire_runtime_fingerprint() {
  local revision=$1
  local entry
  git -C "$protocol_work" ls-tree -r "$revision" -- \
    crates/kafka-wire-core crates/kafka-wire-records crates/kafka-wire |
    while IFS= read -r entry; do
      case "$entry" in
        *$'\tcrates/kafka-wire-core/src/lib.rs' | \
        *$'\tcrates/kafka-wire/Cargo.toml' | \
        *$'\tcrates/kafka-wire/src/generated/MANIFEST.json' | \
        *$'\tcrates/kafka-wire/src/lib.rs') ;;
        *) printf '%s\n' "$entry" ;;
      esac
    done |
    git hash-object --stdin
}

prepare_client() {
  local client_root=$1
  mkdir -p "$client_root/scripts" "$client_root/dependencies"
  cp "$repo_root/scripts/bootstrap-siblings" "$client_root/scripts/bootstrap-siblings"
  cp "$repo_root/scripts/check-dependency-provenance" \
    "$client_root/scripts/check-dependency-provenance"
}

write_revisions() {
  local client_root=$1
  local driver=$2
  local wire=$3
  {
    printf 'KAFKA_DRIVER_REVISION=%s\n' "$driver"
    printf 'KAFKA_PROTOCOL_REVISION=%s\n' "$wire"
  } > "$client_root/dependencies/sibling-revisions.env"
}

write_attestation() {
  local client_root=$1
  local driver=$2
  local wire=$3
  local driver_fingerprint=$4
  local wire_fingerprint=$5
  local declared_wire=$6
  {
    printf 'driver_revision\twire_revision\tdriver_runtime_fingerprint\twire_runtime_fingerprint\tdriver_declared_wire_revision\n'
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$driver" "$wire" "$driver_fingerprint" "$wire_fingerprint" \
      "$declared_wire"
  } > "$client_root/dependencies/public-sibling-pair.tsv"
}

run_bootstrap() {
  local client_root=$1
  local log=$2
  KAFKA_CLIENT_DRIVER_REPOSITORY="file://$driver_origin" \
    KAFKA_CLIENT_PROTOCOL_REPOSITORY="file://$protocol_origin" \
    "$client_root/scripts/bootstrap-siblings" > "$log" 2>&1
}

expect_bootstrap_failure() {
  local client_root=$1
  local log=$2
  local scenario=$3
  local evidence=$4
  if run_bootstrap "$client_root" "$log"; then
    echo "bootstrap scenario unexpectedly passed: $scenario" >&2
    exit 1
  fi
  if ! grep -Fq "$evidence" "$log"; then
    echo "bootstrap scenario failed without expected evidence: $scenario" >&2
    sed -n '1,120p' "$log" >&2
    exit 1
  fi
}

initialize_protocol
initialize_driver
protocol_revision=$(git -C "$protocol_work" rev-parse --verify 'HEAD^{commit}')
previous_protocol_revision=$(git -C "$protocol_work" rev-parse --verify 'HEAD^1^{commit}')
driver_revision=$(git -C "$driver_work" rev-parse --verify 'HEAD^{commit}')
previous_driver_revision=$(git -C "$driver_work" rev-parse --verify 'HEAD^1^{commit}')
driver_fingerprint=$(driver_runtime_fingerprint "$driver_revision")
wire_fingerprint=$(wire_runtime_fingerprint "$protocol_revision")
previous_driver_fingerprint=$(driver_runtime_fingerprint "$previous_driver_revision")

git clone --bare -q "$driver_work" "$driver_origin"
git clone --bare -q "$protocol_work" "$protocol_origin"

success_root="$sandbox/success"
success_client="$success_root/kafka-client"
success_log="$success_root/bootstrap.log"
prepare_client "$success_client"
write_revisions "$success_client" "$driver_revision" "$protocol_revision"
write_attestation \
  "$success_client" "$driver_revision" "$protocol_revision" \
  "$driver_fingerprint" "$wire_fingerprint" "$unreachable_declared_wire"
run_bootstrap "$success_client" "$success_log"

test "$(git -C "$success_root/kafka-driver" rev-parse 'HEAD^{commit}')" = \
  "$driver_revision"
test "$(git -C "$success_root/kafka-protocol" rev-parse 'HEAD^{commit}')" = \
  "$protocol_revision"
test "$(git -C "$success_root/kafka-driver" rev-list --count HEAD)" = 1
test "$(git -C "$success_root/kafka-protocol" rev-list --count HEAD)" = 1
if git -C "$success_root/kafka-driver" \
  cat-file -e "$previous_driver_revision^{commit}" 2>/dev/null; then
  echo "bootstrap fetched an unrequested kafka-driver ancestor" >&2
  exit 1
fi
if git -C "$success_root/kafka-protocol" \
  cat-file -e "$previous_protocol_revision^{commit}" 2>/dev/null; then
  echo "bootstrap fetched an unrequested kafka-wire ancestor" >&2
  exit 1
fi
if git -C "$success_root/kafka-protocol" \
  cat-file -e "$unreachable_declared_wire^{commit}" 2>/dev/null; then
  echo "bootstrap unexpectedly resolved the driver's declared source-wire scalar" >&2
  exit 1
fi
test -z "$(git -C "$success_root/kafka-driver" for-each-ref --format='%(refname)')"
test -z "$(git -C "$success_root/kafka-protocol" for-each-ref --format='%(refname)')"
grep -Fq "kafka-driver commit=$driver_revision tree=" "$success_log"
grep -Fq "kafka-protocol commit=$protocol_revision tree=" "$success_log"
grep -Fq \
  "public-sibling-pair driver=$driver_revision wire=$protocol_revision driver-runtime=$driver_fingerprint wire-runtime=$wire_fingerprint driver-declared-wire=$unreachable_declared_wire" \
  "$success_log"
grep -Fq \
  "installed reviewed public sibling pair driver=$driver_revision wire=$protocol_revision" \
  "$success_log"

run_bootstrap "$success_client" "$success_log"
grep -Fq "sibling checkouts already match the reviewed public pair" "$success_log"

write_revisions "$success_client" "$previous_driver_revision" "$protocol_revision"
write_attestation \
  "$success_client" "$previous_driver_revision" "$protocol_revision" \
  "$previous_driver_fingerprint" "$wire_fingerprint" "$unreachable_declared_wire"
expect_bootstrap_failure \
  "$success_client" "$success_log" "wrong existing checkout" \
  "does not match reviewed revision"
test "$(git -C "$success_root/kafka-driver" rev-parse 'HEAD^{commit}')" = \
  "$driver_revision"

tamper_root="$sandbox/tampered-attestation"
tamper_client="$tamper_root/kafka-client"
tamper_log="$tamper_root/bootstrap.log"
prepare_client "$tamper_client"
write_revisions "$tamper_client" "$driver_revision" "$protocol_revision"
write_attestation \
  "$tamper_client" "$driver_revision" "$protocol_revision" \
  0000000000000000000000000000000000000000 \
  "$wire_fingerprint" "$unreachable_declared_wire"
expect_bootstrap_failure \
  "$tamper_client" "$tamper_log" "tampered runtime attestation" \
  "kafka-driver runtime fingerprint"
test ! -e "$tamper_root/kafka-driver"
test ! -e "$tamper_root/kafka-protocol"
if find "$tamper_root" -maxdepth 1 -name '.kafka-client-bootstrap.*' | grep -q .; then
  echo "bootstrap left a staging directory after attestation failure" >&2
  exit 1
fi

revision_data_root="$sandbox/executable-revision-data"
revision_data_client="$revision_data_root/kafka-client"
revision_data_log="$revision_data_root/bootstrap.log"
revision_marker="$revision_data_root/evaluated"
prepare_client "$revision_data_client"
write_attestation \
  "$revision_data_client" "$driver_revision" "$protocol_revision" \
  "$driver_fingerprint" "$wire_fingerprint" "$unreachable_declared_wire"
{
  printf 'KAFKA_DRIVER_REVISION=%s\n' "\$(touch $revision_marker)"
  printf 'KAFKA_PROTOCOL_REVISION=%s\n' "$protocol_revision"
} > "$revision_data_client/dependencies/sibling-revisions.env"
expect_bootstrap_failure \
  "$revision_data_client" "$revision_data_log" "executable revision data" \
  "invalid kafka-driver revision assignment"
test ! -e "$revision_marker"
test ! -e "$revision_data_root/kafka-driver"
test ! -e "$revision_data_root/kafka-protocol"

attestation_data_root="$sandbox/executable-attestation-data"
attestation_data_client="$attestation_data_root/kafka-client"
attestation_data_log="$attestation_data_root/bootstrap.log"
attestation_marker="$attestation_data_root/evaluated"
prepare_client "$attestation_data_client"
write_revisions "$attestation_data_client" "$driver_revision" "$protocol_revision"
{
  printf 'driver_revision\twire_revision\tdriver_runtime_fingerprint\twire_runtime_fingerprint\tdriver_declared_wire_revision\n'
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$driver_revision" "$protocol_revision" "$driver_fingerprint" \
    "$wire_fingerprint" "\$(touch $attestation_marker)"
} > "$attestation_data_client/dependencies/public-sibling-pair.tsv"
expect_bootstrap_failure \
  "$attestation_data_client" "$attestation_data_log" \
  "executable attestation data" "noncanonical row"
test ! -e "$attestation_marker"
test ! -e "$attestation_data_root/kafka-driver"
test ! -e "$attestation_data_root/kafka-protocol"

partial_root="$sandbox/partial-existing-state"
partial_client="$partial_root/kafka-client"
partial_log="$partial_root/bootstrap.log"
prepare_client "$partial_client"
write_revisions "$partial_client" "$driver_revision" "$protocol_revision"
write_attestation \
  "$partial_client" "$driver_revision" "$protocol_revision" \
  "$driver_fingerprint" "$wire_fingerprint" "$unreachable_declared_wire"
mkdir "$partial_root/kafka-driver"
expect_bootstrap_failure \
  "$partial_client" "$partial_log" "partial existing sibling state" \
  "existing sibling state is incomplete or noncanonical"
test -d "$partial_root/kafka-driver"
test ! -e "$partial_root/kafka-protocol"

rollback_root="$sandbox/second-install-move-failure"
rollback_client="$rollback_root/kafka-client"
rollback_log="$rollback_root/bootstrap.log"
rollback_bin="$rollback_root/bin"
rollback_counter="$rollback_root/mv-counter"
prepare_client "$rollback_client"
write_revisions "$rollback_client" "$driver_revision" "$protocol_revision"
write_attestation \
  "$rollback_client" "$driver_revision" "$protocol_revision" \
  "$driver_fingerprint" "$wire_fingerprint" "$unreachable_declared_wire"
mkdir -p "$rollback_bin"
# The generated wrapper expands these variables at its own runtime.
# shellcheck disable=SC2016
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  ': "${KAFKA_BOOTSTRAP_TEST_MV_COUNTER:?}"' \
  'count=0' \
  'if [[ -f "$KAFKA_BOOTSTRAP_TEST_MV_COUNTER" ]]; then' \
  '  read -r count < "$KAFKA_BOOTSTRAP_TEST_MV_COUNTER"' \
  'fi' \
  'count=$((count + 1))' \
  'printf "%s\\n" "$count" > "$KAFKA_BOOTSTRAP_TEST_MV_COUNTER"' \
  'if [[ "$count" -eq 2 ]]; then' \
  '  echo "injected second install move failure" >&2' \
  '  exit 73' \
  'fi' \
  'exec /bin/mv "$@"' \
  > "$rollback_bin/mv"
chmod 700 "$rollback_bin/mv"
if PATH="$rollback_bin:$PATH" \
  KAFKA_BOOTSTRAP_TEST_MV_COUNTER="$rollback_counter" \
  run_bootstrap "$rollback_client" "$rollback_log"; then
  echo "bootstrap unexpectedly survived the second install move failure" >&2
  exit 1
fi
grep -Fq "injected second install move failure" "$rollback_log"
test ! -e "$rollback_root/kafka-driver"
test ! -e "$rollback_root/kafka-protocol"
if find "$rollback_root" -maxdepth 1 -name '.kafka-client-bootstrap.*' | grep -q .; then
  echo "bootstrap left a staging directory after install rollback" >&2
  exit 1
fi

signal_root="$sandbox/first-install-move-signal"
signal_client="$signal_root/kafka-client"
signal_log="$signal_root/bootstrap.log"
signal_bin="$signal_root/bin"
signal_counter="$signal_root/mv-counter"
prepare_client "$signal_client"
write_revisions "$signal_client" "$driver_revision" "$protocol_revision"
write_attestation \
  "$signal_client" "$driver_revision" "$protocol_revision" \
  "$driver_fingerprint" "$wire_fingerprint" "$unreachable_declared_wire"
mkdir -p "$signal_bin"
# The generated wrapper expands these variables at its own runtime.
# shellcheck disable=SC2016
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  ': "${KAFKA_BOOTSTRAP_TEST_MV_COUNTER:?}"' \
  'count=0' \
  'if [[ -f "$KAFKA_BOOTSTRAP_TEST_MV_COUNTER" ]]; then' \
  '  read -r count < "$KAFKA_BOOTSTRAP_TEST_MV_COUNTER"' \
  'fi' \
  'count=$((count + 1))' \
  'printf "%s\\n" "$count" > "$KAFKA_BOOTSTRAP_TEST_MV_COUNTER"' \
  'if [[ "$count" -eq 1 ]]; then' \
  '  /bin/mv "$@"' \
  '  echo "injected signal after first install move" >&2' \
  '  kill -TERM "$PPID"' \
  '  exit 0' \
  'fi' \
  'exec /bin/mv "$@"' \
  > "$signal_bin/mv"
chmod 700 "$signal_bin/mv"
if PATH="$signal_bin:$PATH" \
  KAFKA_BOOTSTRAP_TEST_MV_COUNTER="$signal_counter" \
  run_bootstrap "$signal_client" "$signal_log"; then
  echo "bootstrap unexpectedly survived the first install move signal" >&2
  exit 1
fi
grep -Fq "injected signal after first install move" "$signal_log"
test ! -e "$signal_root/kafka-driver"
test ! -e "$signal_root/kafka-protocol"
test ! -e "$signal_root/.kafka-client-bootstrap.lock"
if find "$signal_root" -maxdepth 1 -name '.kafka-client-bootstrap.*' | grep -q .; then
  echo "bootstrap left a staging directory after the install signal" >&2
  exit 1
fi

echo "bootstrap exact public-pair network fixture passed"
